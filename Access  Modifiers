// Delegates
//normal delegates

MyMaths.MyMathsDelegate Eval = new MyMaths.MyMathsDelegate(MyMaths.Add);
Eval(5, 9); // 14

// MultiCast Delegates

MyMaths.MyMathsDelegate MultiEval;

MultiEval = MyMaths.Mult;
MultiEval(5, 9);// 45

MultiEval = MyMaths.Div;
MultiEval(2, 0); // cant divide by zero

MultiEval = MyMaths.Sub;
MultiEval(4, 2);


public class MyMaths
{
    public delegate void MyMathsDelegate(double num1, double num2);

    public static void Add(double a, double b)
    {
        Console.WriteLine(a + b);
    }

    public static void Sub(double a, double b)
    {
        Console.WriteLine(a - b);
    }

    public static void Mult(double a, double b)
    {
        Console.WriteLine(a * b);
    }

    public static void Div(double a, double b)
    {
        if(b !=0 ) Console.WriteLine(a / b);
        else Console.WriteLine("Cant divide by zero");
    }
}


